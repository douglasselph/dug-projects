# Generated TTS save files and reports
output/*

# Keep the output directory in Git
!output/.gitkeep

# Exported artwork: kept locally, sourced from Component Studio or Google Drive.
# The README and other text files under assets/ remain tracked.
assets/**/*.png
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.PNG
assets/**/*.JPG
assets/**/*.JPEG
assets/doc
source/
docs/

# Python temporary files
__pycache__/
*.pyc

# Temporary files
*.tmp
*.bak
